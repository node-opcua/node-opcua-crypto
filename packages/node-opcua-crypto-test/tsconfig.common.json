{
    "compilerOptions": {
        // see packages/node-opcua-crypto/tsconfig.common.json: tsup's --dts build injects
        // a deprecated `baseUrl` (TS5101 under TypeScript 6.0).
        "ignoreDeprecations": "6.0",
        "target": "es2020",
        "esModuleInterop": true,
        "skipLibCheck": false,
        "moduleResolution": "NodeNext",
        "module": "NodeNext",
        "sourceMap": true,
        "strict": true,
        "listFiles": false,
        "traceResolution": false,
        "types": [
            "node"
        ],
        "rootDir": "."
    },
    "include": [
        "./test/*.ts"
    ]
}