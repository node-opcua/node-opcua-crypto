{
    "compilerOptions": {
        // Unbundled per-file emit with tsc, mirroring the node-opcua monorepo scheme
        // (NodeNext module + resolution). The source already carries explicit ".js"
        // extensions on every relative import, which NodeNext requires.
        "target": "es2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "declaration": true,
        "sourceMap": true,
        "strict": true,
        "types": ["node"]
    }
}
