{
    "name": "node-opcua-crypto",
    "version": "5.3.6",
    "type": "module",
    "description": "Crypto tools for Node-OPCUA",
    "//main": "main/types are the pre-'exports' fallback, used only by resolvers that ignore the exports map (TypeScript's classic 'node' resolution, older bundlers). They are deliberately left as the ESM pair so that path behaves exactly as it did before - do not 'fix' one without the other, or that fallback becomes a CJS file described by ESM types.",
    "types": "./dist/index.d.ts",
    "main": "./dist/index.js",
    "//exports-bundled-web": "./bundled-web keeps the single shared \"types\" key on purpose, and it is NOT the defect described below: the hazard only exists when a \"require\" condition is present, and this subpath has none - it is a pre-bundled browser build with no .cjs counterpart. Nesting its types under \"import\" instead leaves the require condition with nothing, so a CommonJS consumer doing `await import(...)` loses types altogether. NOTE: keep notes like this OUTSIDE the exports object - every key in there is a subpath pattern, and a non-'.' key alongside '.' keys invalidates the whole map.",
    "//exports": "types are declared PER CONDITION on purpose. A single shared \"types\" key is resolved for BOTH import and require; since this package is \"type\": \"module\", a bare .d.ts is an ES module, so a CommonJS consumer got ESM types describing the real .cjs it requires. TypeScript reports that as TS1479 under module: node16, and attw as FalseESM. The .d.cts files already existed - tsup emits them from dts:true with format esm+cjs - the map simply never pointed at them.",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./web": {
            "import": {
                "types": "./dist/source/index_web.d.ts",
                "default": "./dist/source/index_web.js"
            },
            "require": {
                "types": "./dist/source/index_web.d.cts",
                "default": "./dist/source/index_web.cjs"
            }
        },
        "./bundled-web": {
            "types": "./dist/source/index_web.d.ts",
            "import": "./dist-web-bundle/index_web.js"
        },
        "./node": {
            "import": {
                "types": "./dist/source_nodejs/index.d.ts",
                "default": "./dist/source_nodejs/index.js"
            },
            "require": {
                "types": "./dist/source_nodejs/index.d.cts",
                "default": "./dist/source_nodejs/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build:bundle": "tsup --config tsup.config.bundle.ts",
        "build:web-bundle": "tsup --config tsup.config.web-bundle.ts",
        "build:tsup": "tsup",
        "build:clean": "npx rimraf ./dist ./dist-* *.tsbuildinfo",
        "build:types": "tsc -p tsconfig.types.json",
        "build:demo": "node web/esbuild.mjs",
        "build": "npm run build:tsup",
        "prepare": "npm run build",
        "tslint": "biome lint --fix",
        "lint": "biome check",
        "makedoc": "npx typedoc  index.ts --excludeNotDocumented --exclude \"_*\" --excludePrivate --excludeProtected --excludeExternals -out doc",
        "cost-of-modules": "npx -y slow-deps",
        "format": "biome format --write",
        "experiment": "tsc test/test_peculiar_edge_case.ts -t es2021 -m nodenext"
    },
    "keywords": [
        "OPCUA",
        "opcua",
        "m2m",
        "iot",
        "opc ua",
        "internet of things"
    ],
    "makedoc": "npx typedoc packages/node-opcua-crypto/index.ts -out doc",
    "author": "Etienne Rossignon",
    "license": "MIT",
    "engine": {
        "node": ">=18.0"
    },
    "devDependencies": {
        "@types/node": "^24.12.4",
        "@types/sshpk": "^1.17.4",
        "assert": "^2.1.0",
        "buffer": "^6.0.3",
        "constants-browserify": "^1.0.0",
        "crypto-browserify": "^3.12.1",
        "events": "^3.3.0",
        "stream-browserify": "^3.0.0",
        "string_decoder": "^1.3.0",
        "util": "^0.12.5",
        "vm-browserify": "^1.1.2"
    },
    "dependencies": {
        "@peculiar/webcrypto": "^1.7.1",
        "@peculiar/x509": "^2.0.0",
        "reflect-metadata": "^0.2.2",
        "sshpk": "^1.18.0"
    },
    "repository": {
        "type": "git",
        "url": "git://github.com/node-opcua/node-opcua-crypto.git"
    },
    "bugs": {
        "url": "https://github.com/node-opcua/node-opcua-crypto/issues"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "gitHead": "64eadc79f3f61c0ab82060cc8c20359a188cb541"
}
